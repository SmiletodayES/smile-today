# Copy this file's contents into Vercel → Project → Settings → Environment
# Variables (do NOT commit a real .env file with real secrets to git).

# Stripe — Developers → API keys in the Stripe dashboard.
# Use the test-mode keys (start with sk_test_ / whsec_...) until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_xxx
# Created when you add a webhook endpoint (Developers → Webhooks) pointing at
# https://YOUR-DOMAIN/api/webhook and select the "checkout.session.completed" event.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Printify — printify.com/app/account/api, and your shop's numeric id from
# GET https://api.printify.com/v1/shops.json
PRINTIFY_API_TOKEN=xxx
PRINTIFY_SHOP_ID=xxx

# Pick any random string — this protects the one-time /api/debug-catalog
# helper (see that file). Remove both the file and this variable once you've
# copied your real product/variant IDs into lib/products-data.js.
ADMIN_DEBUG_KEY=choose-a-random-string
